//
// Пароль хранится только в реквизите формы на время её работы: он не
// сохраняется в настройках, не попадает в отчёт и не пишется в журнал.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Логин = ИмяПользователя();
	Элементы.ОтборВид.СписокВыбора.Добавить("Все", НСтр("ru = 'Все'"));
	Элементы.ОтборВид.СписокВыбора.Добавить("Опубликованные", НСтр("ru = 'Опубликованные'"));
	Элементы.ОтборВид.СписокВыбора.Добавить("Неопубликованные", НСтр("ru = 'Неопубликованные'"));
	ОтборВид = "Все";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьДоступность();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтчетОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)

	Если ТипЗнч(Расшифровка) = Тип("Строка") И СтрНачинаетсяС(Расшифровка, "https://") Тогда
		СтандартнаяОбработка = Ложь;
		ПерейтиПоНавигационнойСсылке(Расшифровка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)

	ПроверитьНаСервере();
	ПрименитьОтбор();
	РазвернутьДерево();
	ОбновитьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВСостав(Команда)

	Выбранные = Новый Массив;
	Для Каждого Строка Из Объекты Цикл
		Если Строка.Выбран И Не Строка.Опубликован Тогда
			Выбранные.Добавить(Строка.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте неопубликованные объекты, которые нужно добавить в состав OData.'"));
		Возврат;
	КонецЕсли;

	Список = Новый Массив;
	Для Индекс = 0 По Мин(Выбранные.ВГраница(), 29) Цикл
		Список.Добавить("• " + Выбранные[Индекс]);
	КонецЦикла;
	Если Выбранные.Количество() > 30 Тогда
		Список.Добавить(СтрШаблон(НСтр("ru = '… и ещё %1'"), Выбранные.Количество() - 30));
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Добавить в состав стандартного интерфейса OData объекты (%1)?
		|
		|%2
		|
		|Остальной состав не изменится, ничего не будет убрано.'"),
		Выбранные.Количество(), СтрСоединить(Список, Символы.ПС));

	ПоказатьВопрос(Новый ОписаниеОповещения("ДобавитьВСоставПослеВопроса", ЭтотОбъект, Выбранные),
		Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВСоставПослеВопроса(Ответ, Выбранные) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Сообщение = ДобавитьВСоставНаСервере(Выбранные);
	ПрименитьОтбор();
	РазвернутьДерево();
	ОбновитьДоступность();
	ПоказатьПредупреждение(, Сообщение);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВидимые(Команда)

	Для Каждого Строка Из Объекты Цикл
		Если Строка.Видим И Не Строка.Опубликован Тогда
			Строка.Выбран = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого Строка Из Объекты Цикл
		Строка.Выбран = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ВыполнитьПроверки(АдресПубликации, Логин, Пароль);
	ЗаполнитьРезультаты(Обработка, Результат);

КонецПроцедуры

&НаСервере
Функция ДобавитьВСоставНаСервере(Выбранные)

	Обработка = РеквизитФормыВЗначение("Объект");
	Итог = Обработка.ДобавитьВСоставOData(Выбранные);

	// Повторяем проверки, чтобы показать фактический состав после записи.
	Результат = Обработка.ВыполнитьПроверки(АдресПубликации, Логин, Пароль);
	ЗаполнитьРезультаты(Обработка, Результат);
	Возврат Итог.Сообщение;

КонецФункции

&НаСервере
Процедура ЗаполнитьРезультаты(Обработка, Результат)

	ЕстьПраваАдминистратора = Результат.ЕстьПраваАдминистратора;

	Дерево = РеквизитФормыВЗначение("Результаты");
	Дерево.Строки.Очистить();
	Для Каждого Проверка Из Результат.Проверки Цикл
		Строка = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Проверка, "Наименование, Вердикт, Подробности");
		Для Каждого Подробность Из Проверка.Строки Цикл
			ЗаполнитьЗначенияСвойств(Строка.Строки.Добавить(), Подробность);
		КонецЦикла;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "Результаты");

	Объекты.Очистить();
	Для Каждого Описание Из Результат.Объекты Цикл
		Строка = Объекты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Описание);
		Строка.Видим = Истина;
	КонецЦикла;

	Отчет = Обработка.СформироватьОтчет(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтбор()

	Подстрока = НРег(СокрЛП(ОтборТекст));
	Для Каждого Строка Из Объекты Цикл
		ПоВиду = ОтборВид = "Все"
			Или ОтборВид = "Опубликованные" И Строка.Опубликован
			Или ОтборВид = "Неопубликованные" И Не Строка.Опубликован;
		ПоТексту = ПустаяСтрока(Подстрока)
			Или СтрНайти(НРег(Строка.ПолноеИмя), Подстрока) > 0
			Или СтрНайти(НРег(Строка.Синоним), Подстрока) > 0;
		Строка.Видим = ПоВиду И ПоТексту;
	КонецЦикла;
	Элементы.Объекты.ОтборСтрок = Новый ФиксированнаяСтруктура("Видим", Истина);

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево()

	Для Каждого Строка Из Результаты.ПолучитьЭлементы() Цикл
		Элементы.Результаты.Развернуть(Строка.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступность()

	Элементы.ДобавитьВСостав.Доступность = ЕстьПраваАдминистратора;

КонецПроцедуры

#КонецОбласти
