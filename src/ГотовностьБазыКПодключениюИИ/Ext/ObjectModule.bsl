#КонецОбласти

Функция ВывестиСтроку(Документ, Текст, Колонка, Жирный = Ложь, Размер = 10, Курсив = Ложь)

	НомерСтроки = Документ.ВысотаТаблицы + 1;
	Область = Документ.Область(НомерСтроки, Колонка);
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт(, Размер, Жирный, Курсив);
	Если Колонка = 1 Тогда
		Документ.Область(НомерСтроки, 1, НомерСтроки, 1).ШиринаКолонки = 3;
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Документ.Область(НомерСтроки, 1).Текст = " ";
	КонецЕсли;
	Возврат Область;

