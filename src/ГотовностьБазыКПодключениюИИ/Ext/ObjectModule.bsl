#Область Проверка5

Функция ПроверкаДобавленияВСостав(ЕстьПрава, Опубликованные, Объекты)

	Проверка = НоваяПроверка(НСтр("ru = '5. Добавление объектов в состав OData'"));
	Если Не ЕстьПрава Тогда
		Проверка.Вердикт = ВердиктНеПроверено(ПричинаНетПрав());
		Возврат Проверка;
	КонецЕсли;
	Если Опубликованные = Неопределено Тогда
		Проверка.Вердикт = ВердиктНеПроверено(НСтр("ru = 'не удалось прочитать состав OData'"));
		Возврат Проверка;
	КонецЕсли;

	Неопубликовано = 0;
	Для Каждого Объект Из Объекты Цикл
		Неопубликовано = Неопубликовано + ?(Объект.Опубликован, 0, 1);
	КонецЦикла;
	Проверка.Вердикт = ВердиктГотово();
	Проверка.Подробности = СтрШаблон(НСтр("ru = 'Доступно. Неопубликованных объектов: %1. Отметьте нужные на вкладке «Объекты OData» и нажмите «Добавить в состав OData». Обработка только добавляет объекты и ничего не убирает.'"), Неопубликовано);
	Возврат Проверка;

