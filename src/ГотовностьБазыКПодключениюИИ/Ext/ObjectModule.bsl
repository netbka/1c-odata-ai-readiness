#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет проверки 1–5.
//
// Параметры:
//   АдресПубликации - Строка - адрес веб-публикации базы, может быть пустым.
//   Логин, Пароль - Строка - учётные данные для проверки публикации. Пароль
//     используется только в HTTP-запросе и никуда не записывается.
//
// Возвращаемое значение:
//   Структура:
//     * Проверки - Массив из Структура (Наименование, Вердикт, Подробности, Строки).
//     * Объекты - Массив из Структура (ПолноеИмя, Синоним, Класс, Опубликован).
//     * ЕстьПраваАдминистратора - Булево.
//
Функция ВыполнитьПроверки(Знач АдресПубликации = "", Знач Логин = "", Знач Пароль = "") Экспорт

	ЕстьПрава = ЕстьПраваАдминистратора();
	Результат = Новый Структура;
	Результат.Вставить("ЕстьПраваАдминистратора", ЕстьПрава);
	Результат.Вставить("Объекты", Новый Массив);
	Результат.Вставить("Проверки", Новый Массив);

	Результат.Проверки.Добавить(ПроверкаПлатформыИБазы());

	Опубликованные = Неопределено;
	Результат.Проверки.Добавить(ПроверкаСоставаOData(ЕстьПрава, Опубликованные, Результат.Объекты));
	Результат.Проверки.Добавить(ПроверкаПользователей(ЕстьПрава, Опубликованные));
	Результат.Проверки.Добавить(ПроверитьПубликацию(АдресПубликации, Логин, Пароль));
	Результат.Проверки.Добавить(ПроверкаДобавленияВСостав(ЕстьПрава, Опубликованные, Результат.Объекты));

	Возврат Результат;

КонецФункции

// Добавляет объекты в состав стандартного интерфейса OData. Ничего не убирает.
//
// Параметры:
//   ПолныеИмена - Массив из Строка - полные имена объектов метаданных.
//
// Возвращаемое значение:
//   Структура:
//     * Успешно - Булево.
//     * Сообщение - Строка.
//     * Добавлено - Массив из Строка.
//
Функция ДобавитьВСоставOData(Знач ПолныеИмена) Экспорт

	Результат = Новый Структура("Успешно, Сообщение, Добавлено", Ложь, "", Новый Массив);

	Если Не ЕстьПраваАдминистратора() Тогда
		Результат.Сообщение = НСтр("ru = 'Не выполнено: нужны административные права.'");
		Возврат Результат;
	КонецЕсли;

	ДопустимыеКлассы = Новый Соответствие;
	Для Каждого Описание Из ОписаниеКлассов() Цикл
		Для Каждого Объект Из Описание.Коллекция Цикл
			ДопустимыеКлассы.Вставить(Объект.ПолноеИмя(), Истина);
		КонецЦикла;
	КонецЦикла;

	СоставДо = ПолучитьСоставСтандартногоИнтерфейсаOData();
	ИменаДо = Новый Соответствие;
	Для Каждого Объект Из СоставДо Цикл
		ИменаДо.Вставить(Объект.ПолноеИмя(), Истина);
	КонецЦикла;

	НовыйСостав = Новый Массив;
	Для Каждого Объект Из СоставДо Цикл
		НовыйСостав.Добавить(Объект);
	КонецЦикла;

	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Если ИменаДо[ПолноеИмя] <> Неопределено Или ДопустимыеКлассы[ПолноеИмя] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объект = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если Объект <> Неопределено Тогда
			НовыйСостав.Добавить(Объект);
			Результат.Добавлено.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Добавлено.Количество() = 0 Тогда
		Результат.Сообщение = НСтр("ru = 'Нечего добавлять: выбранные объекты уже опубликованы или не выбраны.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		УстановитьСоставСтандартногоИнтерфейсаOData(НовыйСостав);
	Исключение
		Результат.Добавлено = Новый Массив;
		Результат.Сообщение = НСтр("ru = 'Состав не изменён. Платформа сообщила:'") + " "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// Повторное чтение: прежний состав должен остаться целиком.
	ИменаПосле = Новый Соответствие;
	Для Каждого Объект Из ПолучитьСоставСтандартногоИнтерфейсаOData() Цикл
		ИменаПосле.Вставить(Объект.ПолноеИмя(), Истина);
	КонецЦикла;
	Для Каждого Элемент Из ИменаДо Цикл
		Если ИменаПосле[Элемент.Ключ] = Неопределено Тогда
			Результат.Сообщение = СтрШаблон(НСтр("ru = 'После записи в составе нет объекта %1, который был в нём раньше. Проверьте состав вручную.'"), Элемент.Ключ);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПолноеИмя Из Результат.Добавлено Цикл
		Если ИменаПосле[ПолноеИмя] = Неопределено Тогда
			Результат.Сообщение = СтрШаблон(НСтр("ru = 'Платформа не добавила объект %1 в состав.'"), ПолноеИмя);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Успешно = Истина;
	Результат.Сообщение = СтрШаблон(НСтр("ru = 'Добавлено в состав OData: %1. Прежний состав сохранён.'"), Результат.Добавлено.Количество());
	Возврат Результат;

КонецФункции

// Формирует отчёт по результатам ВыполнитьПроверки.
//
// Возвращаемое значение:
//   ТабличныйДокумент
//
Функция СформироватьОтчет(Знач Результат) Экспорт

	Документ = Новый ТабличныйДокумент;
	Документ.ИмяПараметровПечати = "ГотовностьБазыКПодключениюИИ";

	ВывестиСтроку(Документ, НСтр("ru = 'Готовность базы 1С к подключению ИИ через OData'"), 1, Истина, 14);
	ВывестиСтроку(Документ, СтрШаблон(НСтр("ru = 'База: %1. Дата проверки: %2.'"),
		Метаданные.Синоним, Формат(ТекущаяДатаСеанса(), "Л=ru_RU; ДЛФ=DT")), 1);
	ВывестиСтроку(Документ, НСтр("ru = 'Внимание: отчёт содержит имена пользователей информационной базы. Передавайте его только тем, кому доверяете.'"), 1, Истина, , Истина);
	ВывестиСтроку(Документ, "", 1);

	Для Каждого Проверка Из Результат.Проверки Цикл
		ВывестиСтроку(Документ, Проверка.Наименование + " — " + Проверка.Вердикт, 1, Истина, 11);
		Если ЗначениеЗаполнено(Проверка.Подробности) Тогда
			ВывестиСтроку(Документ, Проверка.Подробности, 2);
		КонецЕсли;
		Для Каждого Строка Из Проверка.Строки Цикл
			Текст = Строка.Наименование;
			Если ЗначениеЗаполнено(Строка.Вердикт) Тогда
				Текст = Текст + " — " + Строка.Вердикт;
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Подробности) Тогда
				Текст = Текст + ": " + Строка.Подробности;
			КонецЕсли;
			ВывестиСтроку(Документ, Текст, 2);
		КонецЦикла;
		ВывестиСтроку(Документ, "", 1);
	КонецЦикла;

	Область = ВывестиСтроку(Документ, НСтр("ru = 'Подключить ИИ к базе под правами сотрудника: nulio.ru'"), 1);
	Область.Гиперссылка = Истина;
	Область.Расшифровка = АдресСайта();

	Документ.ФиксацияСверху = 0;
	Документ.АвтоМасштаб = Истина;
	Возврат Документ;

КонецФункции

