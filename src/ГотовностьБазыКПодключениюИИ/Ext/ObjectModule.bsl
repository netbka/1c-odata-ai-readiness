#Область Проверка4

Функция ПроверитьПубликацию(Знач Адрес, Знач Логин, Знач Пароль)

	Проверка = НоваяПроверка(НСтр("ru = '4. Веб-публикация'"));
	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Проверка.Вердикт = ВердиктНеПроверено(НСтр("ru = 'адрес публикации не указан'"));
		Возврат Проверка;
	КонецЕсли;

	Части = РазобратьАдрес(Адрес);
	Если Части = Неопределено Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Адрес не распознан. Пример: http://server/base'");
		Возврат Проверка;
	КонецЕсли;

	ПутьЗапроса = Части.Путь + "/odata/standard.odata/$metadata";
	ДобавитьСтроку(Проверка, НСтр("ru = 'Запрос'"), "GET " + Части.Схема + "://" + Части.Сервер
		+ ?(Части.Порт = 0, "", ":" + Формат(Части.Порт, "ЧГ=0")) + ПутьЗапроса);

	Попытка
		Защищенное = ?(Части.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
		Соединение = Новый HTTPСоединение(Части.Сервер, ?(Части.Порт = 0, Неопределено, Части.Порт),
			Логин, Пароль, , 30, Защищенное);
		Ответ = Соединение.Получить(Новый HTTPЗапрос(ПутьЗапроса));
	Исключение
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Не удалось соединиться с сервером. Проверьте адрес, порт и что веб-сервер запущен и доступен с сервера 1С.'");
		ДобавитьСтроку(Проверка, НСтр("ru = 'Ошибка'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Проверка;
	КонецПопытки;

	Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Тело = Неопределено Тогда
		Тело = "";
	КонецЕсли;
	ДобавитьСтроку(Проверка, НСтр("ru = 'Код ответа'"), Формат(Ответ.КодСостояния, "ЧГ=0"));

	Код = Ответ.КодСостояния;
	ЭтоHTML = СтрНайти(НРег(Лев(СокрЛ(Тело), 300)), "<html") > 0
		Или СтрНайти(НРег(Лев(СокрЛ(Тело), 300)), "<!doctype html") > 0;

	Если Код = 200 И ЭтоHTML Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Сервер вернул страницу HTML вместо XML. Скорее всего, адрес указывает не на публикацию 1С.'");
	ИначеЕсли Код = 200 Тогда
		Наборы = СтрЧислоВхождений(Тело, "<EntitySet ");
		ДобавитьСтроку(Проверка, НСтр("ru = 'EntitySet в $metadata'"), Формат(Наборы, "ЧН=0; ЧГ=0"));
		Если Наборы = 0 Тогда
			Проверка.Вердикт = ВердиктНужноДействие();
			Проверка.Подробности = НСтр("ru = 'Публикация отвечает, но в $metadata нет ни одного набора: состав OData пуст (проверка 2).'");
		Иначе
			Проверка.Вердикт = ВердиктГотово();
			Проверка.Подробности = СтрШаблон(НСтр("ru = 'Публикация отвечает, доступно наборов: %1.'"), Формат(Наборы, "ЧГ=0"));
			// Платформа отдаёт $metadata целиком, не глядя на права пользователя.
			ДобавитьСтроку(Проверка, НСтр("ru = 'Важно'"),
				НСтр("ru = '$metadata показывает весь опубликованный состав и не зависит от прав. Может ли этот пользователь читать данные, показывает проверка 3.'"));
		КонецЕсли;
	ИначеЕсли Код = 401 Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Ответ 401: неверный логин или пароль, или у пользователя выключена аутентификация 1С.'");
	ИначеЕсли Код = 403 Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Ответ 403: веб-сервер запретил доступ. Проверьте права на каталог публикации.'");
	ИначеЕсли Код = 404 Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Ответ 404: публикации по этому адресу нет, или в ней не включён стандартный интерфейс OData. В Конфигураторе: «Администрирование → Публикация на веб-сервере», флажок «Публиковать стандартный интерфейс OData».'");
	ИначеЕсли ЭтоHTML Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = СтрШаблон(НСтр("ru = 'Ответ %1 со страницей HTML вместо XML. Проверьте адрес публикации.'"), Формат(Код, "ЧГ=0"));
	Иначе
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = СтрШаблон(НСтр("ru = 'Ответ %1. Начало ответа: %2'"), Формат(Код, "ЧГ=0"), Лев(СокрЛП(Тело), 200));
	КонецЕсли;
	Возврат Проверка;

КонецФункции

// Разбирает адрес вида http[s]://сервер[:порт]/путь. Учётные данные из адреса отбрасываются.
Функция РазобратьАдрес(Знач Адрес)

	Схема = "http";
	Позиция = СтрНайти(Адрес, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(Адрес, Позиция - 1));
		Адрес = Сред(Адрес, Позиция + 3);
	КонецЕсли;
	Если Схема <> "http" И Схема <> "https" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Позиция = СтрНайти(Адрес, "/");
	Если Позиция = 0 Тогда
		Узел = Адрес;
		Путь = "";
	Иначе
		Узел = Лев(Адрес, Позиция - 1);
		Путь = Сред(Адрес, Позиция);
	КонецЕсли;
	Позиция = СтрНайти(Узел, "@", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Узел = Сред(Узел, Позиция + 1);
	КонецЕсли;

	Порт = 0;
	Позиция = СтрНайти(Узел, ":", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		ТекстПорта = Сред(Узел, Позиция + 1);
		Узел = Лев(Узел, Позиция - 1);
		Попытка
			Порт = Число(ТекстПорта);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ПустаяСтрока(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Без хвоста: адрес публикации может прийти со «/ru_RU/» или «/odata/...».
	Позиция = СтрНайти(НРег(Путь), "/odata/");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1);
	КонецЕсли;
	Позиция = СтрНайти(Путь, "/ru_RU");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Возврат Новый Структура("Схема, Сервер, Порт, Путь", Схема, Узел, Порт, Путь);

