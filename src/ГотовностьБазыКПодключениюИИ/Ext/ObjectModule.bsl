Функция ПроверкаПользователей(ЕстьПрава, Опубликованные)

	Проверка = НоваяПроверка(НСтр("ru = '3. Пользователи информационной базы'"));
	Если Не ЕстьПрава Тогда
		Проверка.Вердикт = ВердиктНеПроверено(ПричинаНетПрав());
		Возврат Проверка;
	КонецЕсли;
	Если Опубликованные = Неопределено Тогда
		Проверка.Вердикт = ВердиктНеПроверено(НСтр("ru = 'не удалось прочитать состав OData'"));
		Возврат Проверка;
	КонецЕсли;

	// Права проверяются только на объекты, у которых есть право «Чтение».
	ПроверяемыеОбъекты = Новый Массив;
	Для Каждого Элемент Из Опубликованные Цикл
		Если Не СтрНачинаетсяС(Элемент.Ключ, "Перечисление.") Тогда
			ПроверяемыеОбъекты.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Если Пользователи.Количество() = 0 Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'В базе нет пользователей.'");
		ДобавитьСтроку(Проверка, НСтр("ru = 'Что сделать'"),
			НСтр("ru = 'Создайте пользователя для сотрудника, включите ему аутентификацию 1С, задайте пароль и роли с правом чтения нужных объектов.'"));
		Возврат Проверка;
	КонецЕсли;

	КонфигурацияБезРолей = Метаданные.Роли.Количество() = 0;
	ЕстьГотовые = Ложь;
	ЕстьПроблемы = Ложь;
	Для Каждого Пользователь Из Пользователи Цикл

		Читает = 0;
		Для Каждого Объект Из ПроверяемыеОбъекты Цикл
			Попытка
				Если ПравоДоступа("Чтение", Объект, Пользователь) Тогда
					Читает = Читает + 1;
				КонецЕсли;
			Исключение
				// У объекта нет права «Чтение»: не учитываем.
			КонецПопытки;
		КонецЦикла;

		Признаки = Новый Массив;
		Признаки.Добавить(?(Пользователь.АутентификацияСтандартная,
			НСтр("ru = 'аутентификация 1С: да'"), НСтр("ru = 'аутентификация 1С: нет'")));
		Признаки.Добавить(?(Пользователь.ПоказыватьВСпискеВыбора,
			НСтр("ru = 'в списке выбора: да'"), НСтр("ru = 'в списке выбора: нет'")));
		Если КонфигурацияБезРолей Тогда
			Признаки.Добавить(НСтр("ru = 'ролей в конфигурации нет'"));
		Иначе
			// У коллекции ролей пользователя нет метода Количество().
			ЧислоРолей = 0;
			Для Каждого Роль Из Пользователь.Роли Цикл
				ЧислоРолей = ЧислоРолей + 1;
			КонецЦикла;
			Признаки.Добавить(СтрШаблон(НСтр("ru = 'ролей: %1'"), ЧислоРолей));
		КонецЕсли;
		Признаки.Добавить(СтрШаблон(НСтр("ru = 'читает опубликованных объектов: %1 из %2 (перечисления не считаются: у них нет прав)'"), Читает, ПроверяемыеОбъекты.Количество()));

		Вердикт = "";
		Если Пользователь.АутентификацияСтандартная Тогда
			Если Читает = 0 Тогда
				Вердикт = ВердиктНужноДействие();
				ЕстьПроблемы = Истина;
				Если ПроверяемыеОбъекты.Количество() = 0 Тогда
					Признаки.Добавить(НСтр("ru = 'сначала настройте состав OData (проверка 2)'"));
				Иначе
					Признаки.Добавить(НСтр("ru = 'добавьте роль с правом чтения опубликованных объектов'"));
				КонецЕсли;
			Иначе
				Вердикт = ВердиктГотово();
				ЕстьГотовые = Истина;
			КонецЕсли;
		КонецЕсли;

		Имя = ?(ПустаяСтрока(Пользователь.Имя), НСтр("ru = '<без имени>'"), Пользователь.Имя);
		ДобавитьСтроку(Проверка, Имя, СтрСоединить(Признаки, "; "), Вердикт);

	КонецЦикла;

	Если ЕстьПроблемы Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Есть пользователи с аутентификацией 1С, которые не читают ни одного опубликованного объекта. Под ними ИИ не увидит данных.'");
	ИначеЕсли Не ЕстьГотовые Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Нет ни одного пользователя с аутентификацией 1С: по OData войти некому.'");
		ДобавитьСтроку(Проверка, НСтр("ru = 'Что сделать'"),
			НСтр("ru = 'Включите сотруднику аутентификацию 1С в карточке пользователя и задайте пароль.'"));
	Иначе
		Проверка.Вердикт = ВердиктГотово();
		Проверка.Подробности = СтрШаблон(НСтр("ru = 'Пользователей: %1.'"), Пользователи.Количество());
	КонецЕсли;
	Возврат Проверка;

