// Классы объектов, которые могут входить в состав стандартного интерфейса OData.
Функция ОписаниеКлассов()

	Классы = Новый Массив;
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Константы'"), Метаданные.Константы, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Справочники'"), Метаданные.Справочники, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Документы'"), Метаданные.Документы, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Журналы документов'"), Метаданные.ЖурналыДокументов, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Перечисления'"), Метаданные.Перечисления, Ложь));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Планы видов характеристик'"), Метаданные.ПланыВидовХарактеристик, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Планы счетов'"), Метаданные.ПланыСчетов, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Планы видов расчёта'"), Метаданные.ПланыВидовРасчета, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Планы обмена'"), Метаданные.ПланыОбмена, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Регистры сведений'"), Метаданные.РегистрыСведений, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Регистры накопления'"), Метаданные.РегистрыНакопления, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Регистры бухгалтерии'"), Метаданные.РегистрыБухгалтерии, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Регистры расчёта'"), Метаданные.РегистрыРасчета, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Бизнес-процессы'"), Метаданные.БизнесПроцессы, Истина));
	Классы.Добавить(Новый Структура("Класс, Коллекция, ЕстьЧтение", НСтр("ru = 'Задачи'"), Метаданные.Задачи, Истина));
	Возврат Классы;

КонецФункции

Функция ПроверкаСоставаOData(ЕстьПрава, Опубликованные, Объекты)

	Проверка = НоваяПроверка(НСтр("ru = '2. Состав стандартного интерфейса OData'"));
	Если Не ЕстьПрава Тогда
		Проверка.Вердикт = ВердиктНеПроверено(ПричинаНетПрав());
		Возврат Проверка;
	КонецЕсли;

	Попытка
		Состав = ПолучитьСоставСтандартногоИнтерфейсаOData();
	Исключение
		Проверка.Вердикт = ВердиктНеПроверено(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Проверка;
	КонецПопытки;

	Опубликованные = Новый Соответствие;
	Для Каждого Объект Из Состав Цикл
		Опубликованные.Вставить(Объект.ПолноеИмя(), Объект);
	КонецЦикла;

	Всего = 0;
	ВсегоОпубликовано = 0;
	Для Каждого Описание Из ОписаниеКлассов() Цикл
		ВКлассе = 0;
		Опубликовано = 0;
		Для Каждого Объект Из Описание.Коллекция Цикл
			ПолноеИмя = Объект.ПолноеИмя();
			ЕстьВСоставе = Опубликованные[ПолноеИмя] <> Неопределено;
			ВКлассе = ВКлассе + 1;
			Опубликовано = Опубликовано + ?(ЕстьВСоставе, 1, 0);
			Объекты.Добавить(Новый Структура("ПолноеИмя, Синоним, Класс, Опубликован",
				ПолноеИмя, Объект.Синоним, Описание.Класс, ЕстьВСоставе));
		КонецЦикла;
		Если ВКлассе > 0 Тогда
			ДобавитьСтроку(Проверка, Описание.Класс, СтрШаблон(НСтр("ru = 'опубликовано %1 из %2'"), Опубликовано, ВКлассе));
		КонецЕсли;
		Всего = Всего + ВКлассе;
		ВсегоОпубликовано = ВсегоОпубликовано + Опубликовано;
	КонецЦикла;

	Если ВсегоОпубликовано = 0 Тогда
		Проверка.Вердикт = ВердиктНужноДействие();
		Проверка.Подробности = НСтр("ru = 'Состав OData пуст: ИИ не увидит ни одного объекта базы.'");
		ДобавитьСтроку(Проверка, НСтр("ru = 'Что сделать'"),
			НСтр("ru = 'Добавьте нужные объекты в состав. В конфигурации на БСП: «Администрирование → Синхронизация данных → Настройка стандартного интерфейса OData». В любой конфигурации: вкладка «Объекты OData» этой обработки, кнопка «Добавить в состав OData».'"));
	Иначе
		Проверка.Вердикт = ВердиктГотово();
		Проверка.Подробности = СтрШаблон(НСтр("ru = 'Опубликовано объектов: %1 из %2.'"), ВсегоОпубликовано, Всего);
	КонецЕсли;
	Возврат Проверка;

