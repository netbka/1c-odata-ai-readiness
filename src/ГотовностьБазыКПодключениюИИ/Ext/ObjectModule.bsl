Функция ПроверкаПлатформыИБазы()

	Проверка = НоваяПроверка(НСтр("ru = '1. Платформа и база'"));
	Проверка.Вердикт = ВердиктГотово();

	Информация = Новый СистемнаяИнформация;
	ДобавитьСтроку(Проверка, НСтр("ru = 'Версия платформы'"), Информация.ВерсияПриложения);
	ДобавитьСтроку(Проверка, НСтр("ru = 'Конфигурация'"),
		СтрШаблон("%1 (%2), версия %3", Метаданные.Синоним, Метаданные.Имя, Метаданные.Версия));
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
		ДобавитьСтроку(Проверка, НСтр("ru = 'Режим совместимости'"), НСтр("ru = 'не используется'"));
	Иначе
		ДобавитьСтроку(Проверка, НСтр("ru = 'Режим совместимости'"), Строка(Метаданные.РежимСовместимости));
	КонецЕсли;

	Если СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда
		ДобавитьСтроку(Проверка, НСтр("ru = 'Режим работы'"), НСтр("ru = 'файловый'"));
	Иначе
		ДобавитьСтроку(Проверка, НСтр("ru = 'Режим работы'"), НСтр("ru = 'клиент-серверный'"));
	КонецЕсли;

	Попытка
		Расширения = РасширенияКонфигурации.Получить();
		Если Расширения.Количество() = 0 Тогда
			ДобавитьСтроку(Проверка, НСтр("ru = 'Расширения'"), НСтр("ru = 'нет'"));
		КонецЕсли;
		Для Каждого Расширение Из Расширения Цикл
			ДобавитьСтроку(Проверка, НСтр("ru = 'Расширение'"),
				СтрШаблон("%1, версия %2, %3", Расширение.Имя, Расширение.Версия,
					?(Расширение.Активно, НСтр("ru = 'активно'"), НСтр("ru = 'не активно'"))));
		КонецЦикла;
	Исключение
		ДобавитьСтроку(Проверка, НСтр("ru = 'Расширения'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			ВердиктНеПроверено(НСтр("ru = 'нужно право «Администрирование расширений конфигурации»'")));
	КонецПопытки;

	Проверка.Подробности = СтрШаблон(НСтр("ru = 'Платформа %1, %2 %3'"),
		Информация.ВерсияПриложения, Метаданные.Синоним, Метаданные.Версия);
	Возврат Проверка;

КонецФункции

